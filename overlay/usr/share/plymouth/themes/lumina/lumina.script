# Ecran de demarrage LuminaOS : le logo au centre, fondu a l'apparition,
# et trois points qui s'allument tour a tour. Fond sombre, comme l'ecran
# du firmware juste avant : pas de flash blanc.
Window.SetBackgroundTopColor(0.067, 0.078, 0.071);
Window.SetBackgroundBottomColor(0.067, 0.078, 0.071);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 24;
logo.sprite.SetPosition(logo.x, logo.y, 1);
logo.sprite.SetOpacity(0);

dot_image = Image("dot.png");
cx = Window.GetX() + Window.GetWidth() / 2;
for (i = 0; i < 3; i++) {
  dot[i] = Sprite(dot_image);
  dot[i].SetPosition(cx - 4 + (i - 1) * 18, logo.y + logo.image.GetHeight() + 48, 2);
  dot[i].SetOpacity(0);
}

frame = 0;
fun refresh_callback() {
  frame++;
  fade = frame / 25;
  if (fade > 1) fade = 1;
  logo.sprite.SetOpacity(fade);
  active = Math.Int(frame / 15) % 3;
  for (i = 0; i < 3; i++) {
    if (i == active) dot[i].SetOpacity(fade);
    else dot[i].SetOpacity(fade * 0.3);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);
