<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Redemarrer une fois sous Windows, pour la personne devant la machine. -->
<policyconfig>
  <action id="org.luminaos.boot-windows">
    <description>Redemarrer sous Windows</description>
    <message>Redemarrer sous Windows.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/lumina-boot-windows</annotate>
  </action>
</policyconfig>
