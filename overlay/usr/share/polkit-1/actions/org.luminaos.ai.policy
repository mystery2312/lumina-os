<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Modeles de Lumi : telechargement (verifie) et suppression, pour la
     personne devant la machine. -->
<policyconfig>
  <action id="org.luminaos.ai">
    <description>Gerer les modeles de Lumi</description>
    <message>Telecharger ou supprimer un modele de Lumi.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/lumina-ai-model</annotate>
  </action>
</policyconfig>
