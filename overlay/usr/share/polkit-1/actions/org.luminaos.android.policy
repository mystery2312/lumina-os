<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installer Android depuis Reglages. lumina-android refuse sous 4 Go de RAM. -->
<policyconfig>
  <action id="org.luminaos.android">
    <description>Installer les applis Android</description>
    <message>Installer Android (environ 1 Go).</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/lumina-android</annotate>
  </action>
</policyconfig>
