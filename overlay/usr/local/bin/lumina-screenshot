#!/bin/sh
# Capture d'ecran : Impr = chaque ecran (une image par ecran), Maj + Impr =
# une zone a choisir. Enregistree dans Images/Captures d'ecran, puis
# notification.
DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Images")/Captures d'écran"
[ -d "$DIR" ] || mkdir -p "$DIR"
BASE="$DIR/Capture du $(date '+%Y-%m-%d à %H.%M.%S')"
if [ "${1:-}" = "--zone" ]; then
  ZONE=$(slurp -b 00000066 -c 85d6bcff -w 2) || exit 0
  grim -g "$ZONE" "$BASE.png" && LAST="$BASE.png" && N=1
else
  # Ecrans allumes : nom en debut de ligne, puis "  Enabled: yes"
  OUTS=$(wlr-randr 2>/dev/null | awk '/^[^ ]/ { o = $1 } /^  Enabled: yes/ { print o }')
  set -- $OUTS
  N=0
  if [ $# -le 1 ]; then
    grim "$BASE.png" && LAST="$BASE.png" && N=1
  else
    i=0
    for o in "$@"; do
      i=$((i + 1))
      grim -o "$o" "$BASE (écran $i).png" && LAST="$BASE (écran $i).png" && N=$((N + 1))
    done
  fi
fi
[ "$N" -gt 0 ] || exit 1
if [ "$N" = 1 ]; then T="Capture enregistrée"; else T="$N captures enregistrées (une par écran)"; fi
notify-send -a "Capture d'écran" -i "$LAST" "$T" "Dans Images › Captures d'écran"
