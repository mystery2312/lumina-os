#!/bin/sh
# Ouvre le navigateur. Sans argument : la page d'accueil. Avec arguments
# (URL, --app=...) : transmis tels quels. Si Chromium tourne deja, la
# demande est confiee au processus existant : une appli web de plus ne
# coute qu'un onglet, pas un second navigateur.
# Les reglages sont dans /etc/chromium.d/lumina (appliques a tout lancement).
[ $# -eq 0 ] && set -- "file:///usr/share/lumina/start.html"
exec /usr/bin/chromium "$@"
