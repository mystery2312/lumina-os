#!/bin/sh
# Finalisation du rootfs. Execute une seule fois, dans le chroot, par
# mmdebstrap. Doit rester idempotent.
set -eu

# Utilisateur de session, sans mot de passe : la machine se verrouille via
# le compte Google dans le navigateur, pas via une console (modele ChromeOS).
# Dossier personnel sur la partition d'etat : les mises a jour A/B
# remplacent la racine entiere, les fichiers de l'utilisateur doivent donc
# vivre ailleurs : sur la partition d'etat, montee en /home/lumina au
# demarrage par lumina-prepare-home.service.
if ! id lumina >/dev/null 2>&1; then
  useradd -M -d /home/lumina -s /bin/bash -G video,input,render,audio,netdev,plugdev lumina
  passwd -d lumina
fi
# Bluetooth pilotable depuis la session (politique D-Bus de bluez).
getent group bluetooth >/dev/null && usermod -aG bluetooth lumina
# Gestion des imprimantes depuis Reglages (lpadmin)
getent group lpadmin >/dev/null && usermod -aG lpadmin lumina
# Plages d'UID/GID pour les conteneurs sans privileges (Podman).
grep -q '^lumina:' /etc/subuid || usermod --add-subuids 100000-165535 --add-subgids 100000-165535 lumina

. /etc/lumina/build.conf
if [ "$DEV" = 1 ]; then
  # Image de developpement : mot de passe root connu et console de secours.
  echo 'root:lumina' | chpasswd
else
  # Image publiee : aucun acces root par mot de passe.
  passwd -l root >/dev/null
fi

# dbus-broker remplace dbus-daemon : meme protocole, ~2x moins de RAM et
# un demarrage plus rapide. Le variant 'important' peut tirer dbus-daemon,
# on s'assure donc explicitement de qui tient le bus systeme.
if [ -f /lib/systemd/system/dbus-broker.service ]; then
  systemctl disable dbus.service 2>/dev/null || true
  systemctl enable dbus-broker.service 2>/dev/null || true
fi

# Langues de l'interface : francais et anglais (une locale ~ 3 Mo).
sed -i -E 's/^# *(fr_FR.UTF-8|en_US.UTF-8) UTF-8/\1 UTF-8/' /etc/locale.gen
locale-gen >/dev/null

systemctl set-default graphical.target
# Ecran de connexion (greetd) : il lance la session LuminaOS, directement
# tant que le proprietaire est seul, sinon apres le choix d'un compte.

systemctl enable greetd.service
systemctl set-default graphical.target
# Le compte de l'ecran de connexion doit pouvoir ouvrir l'ecran (seatd)
for g in video render input; do getent group "$g" >/dev/null && usermod -aG "$g" _greetd; done
# Graine aleatoire ecrite sur l'ESP a chaque demarrage : bloque sysinit.target
# (lent sur cle USB) pour un gain nul, le noyau a assez d'entropie.
systemctl mask systemd-boot-random-seed.service
# Ecran de demarrage : theme LuminaOS, integre a l'initramfs
plymouth-set-default-theme lumina
update-initramfs -u -k all
systemctl enable lumina-mglru.service
systemctl enable lumina-update.timer
systemctl enable lumina-boot-ok.service
systemctl enable lumina-grow.service
# Securite : pare-feu actif des le demarrage, AppArmor
systemctl enable nftables.service
systemctl enable apparmor.service 2>/dev/null || true
systemctl enable lumina-powerwash.service
systemctl enable cups.service cups-browsed.service avahi-daemon.service 2>/dev/null || true
systemctl enable seatd.service
# ifupdown arrive avec le variant 'important' et ferait doublon avec networkd.
systemctl disable networking.service 2>/dev/null || true
systemctl enable systemd-networkd.service
systemctl enable systemd-resolved.service
systemctl enable iwd.service
systemctl enable zramswap.service 2>/dev/null || true

# Console de secours (developpement seulement) : Alt+F2 = root connecte.
if [ "$DEV" = 1 ]; then
mkdir -p /etc/systemd/system/getty@tty2.service.d
cat > /etc/systemd/system/getty@tty2.service.d/autologin.conf <<'UNIT'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
UNIT
fi

# Pas de swap sur disque : la partition d'etat n'en a pas, zram suffit.
: > /etc/fstab
cat >> /etc/fstab <<'FSTAB'
PARTUUID=44444444-4444-4444-4444-444444444444 /var/lib/lumina ext4 defaults,noatime,nofail 0 2
FSTAB

# Allege : pas de doc, pas de locales inutiles sur une eMMC de 16 Go.
# Chromium : traductions francaise et anglaise uniquement (~40 Mo gagnes).
find /usr/lib/chromium/locales -name '*.pak' ! -name 'fr.pak' ! -name 'en-US.pak' -delete 2>/dev/null || true
rm -rf /usr/share/doc/* /usr/share/man/* /var/cache/apt/archives/*.deb
# Traductions : francais et anglais seulement (~140 Mo gagnes)
find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'fr*' ! -name 'en*' ! -name 'locale.alias' -exec rm -rf {} + 2>/dev/null || true
find /usr/share/help -mindepth 1 -maxdepth 1 ! -name 'fr*' ! -name 'C' -exec rm -rf {} + 2>/dev/null || true
# Le logo et les icones ajoutes par LuminaOS arrivent apres l'installation
# des paquets : sans reconstruire le cache, GTK ne les verrait pas.
gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true
# (glib-compile-schemas : copie privee de libglib, libglib2.0-bin absent)
/usr/lib/x86_64-linux-gnu/glib-2.0/glib-compile-schemas /usr/share/glib-2.0/schemas || true

echo "lumina-setup: termine"
