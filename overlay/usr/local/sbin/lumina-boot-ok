#!/bin/bash
# Demarrage reussi (bureau lance et vivant 20 s apres) : appele par
# lumina-boot-ok.service, avant boot-complete.target.
#   UEFI : systemd-bless-boot valide l'entree de systemd-boot.
#   BIOS : on valide ici l'emplacement dans grubenv (good=..., plus d'essai).
# On met grubenv a jour dans les deux cas : un disque deplace d'un PC UEFI
# vers un PC BIOS demarre ainsi sur la bonne version.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
sleep 20
systemctl is-active --quiet lumina-session
ROOTSRC=$(findmnt -no SOURCE /)
DISK=/dev/$(lsblk -no PKNAME "$ROOTSRC" | head -1 | tr -d ' ')
case "$(lsblk -no PARTLABEL "$ROOTSRC" | tr -d ' ')" in
  ROOT-A) SLOT=a ;; ROOT-B) SLOT=b ;; *) exit 0 ;;
esac
ESP=$(lsblk -lnpo NAME,PARTLABEL "$DISK" | awk '$2 == "ESP" { print $1 }')
[ -b "$ESP" ] || exit 0
M=$(mktemp -d /run/lumina-boot-ok.XXXXXX)
trap 'mountpoint -q "$M" && umount "$M"; rmdir "$M"' EXIT
mount "$ESP" "$M" || exit 0   # sans effet sur la validation UEFI
# Options du noyau de CETTE version dans son entree systemd-boot
UUID=$(lsblk -no PARTUUID "$ROOTSRC" | tr -d ' ')
EXTRA=$(tr ' ' '\n' < /proc/cmdline | grep -E '^console=' | tr '\n' ' ' || true)
OPTS="root=PARTUUID=$UUID $(cat /usr/share/lumina/cmdline) $EXTRA"
for f in "$M"/loader/entries/lumina-$SLOT.conf "$M"/loader/entries/lumina-$SLOT+*.conf; do
  [ -f "$f" ] || continue
  grep -qxF "options  ${OPTS% }" "$f" && continue
  sed "s|^options .*|options  ${OPTS% }|" "$f" > "$f.tmp" && mv "$f.tmp" "$f" || rm -f "$f.tmp"
done
[ -d "$M/grub" ] && ! cmp -s /usr/share/lumina/grub.cfg "$M/grub/grub.cfg" \
  && cp /usr/share/lumina/grub.cfg "$M/grub/grub.cfg"
if [ -f "$M/grub/grubenv" ]; then
  grub-editenv "$M/grub/grubenv" set good=$SLOT || true
  grub-editenv "$M/grub/grubenv" unset try tries || true
fi
