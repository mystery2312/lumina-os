#!/bin/bash
# Compte de l'utilisateur LuminaOS : nom affiche et mot de passe.
#
# Conserves sur la partition d'etat (/var/lib/lumina/config) et reappliques
# a chaque demarrage (lumina-account.service) : une mise a jour remplace la
# partition systeme, et avec elle /etc/passwd et /etc/shadow.
#
#   lumina-account apply              au demarrage (root)
#   lumina-account set-name "Nom"     via pkexec
#   lumina-account set-password       via pkexec ; stdin : ancien puis nouveau
#                                     mot de passe, un par ligne (nouveau
#                                     vide = pas de mot de passe)
#   lumina-account finish             fin de l'assistant de premier demarrage
#
# Un mot de passe deja defini ne peut etre change qu'en donnant l'ancien :
# une appli de la session ne peut pas en imposer un a l'insu de l'utilisateur.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
U=lumina
C=/var/lib/lumina/config
HASH=$C/password.hash      # 0600 root : empreinte du mot de passe
NAME=$C/name               # 0644 : nom affiche
ACC=$C/account.conf        # 0644 : CONFIGURED=0|1, HAS_PASSWORD=0|1

mkdir -p "$C"; chmod 755 "$C"
# Lu comme une donnee, jamais execute (ce script tourne en root)
flag() { [ -r "$ACC" ] || return 0; sed -n "s/^$1=\([01]\)\$/\1/p" "$ACC" | head -1; }
CONFIGURED=$(flag CONFIGURED); CONFIGURED=${CONFIGURED:-0}
HAS_PASSWORD=$(flag HAS_PASSWORD); HAS_PASSWORD=${HAS_PASSWORD:-0}
# Le compte principal n'appartient qu'a son proprietaire
case "${1:-}" in
  set-name|set-password|finish)
    case "${PKEXEC_UID:-$(id -u)}" in 0|1000) ;;
      *) echo "Seul le propriétaire de ce PC peut faire cela." >&2; exit 1 ;;
    esac ;;
esac
save() {
  printf 'CONFIGURED=%s\nHAS_PASSWORD=%s\n' "$CONFIGURED" "$HAS_PASSWORD" > "$ACC.tmp"
  chmod 644 "$ACC.tmp"; mv "$ACC.tmp" "$ACC"
}

case "${1:-}" in
  apply)
    # La partition d'etat doit etre montee : sinon tout serait ecrit sur la
    # partition systeme, puis masque au montage (et perdu a la mise a jour).
    for _ in $(seq 60); do
      mountpoint -q /var/lib/lumina && break
      systemctl start var-lib-lumina.mount 2>/dev/null || true
      sleep 1
    done
    mountpoint -q /var/lib/lumina || { echo "partition d'etat absente" >&2; exit 1; }

    if [ -s "$HASH" ]; then usermod -p "$(cat "$HASH")" "$U"; else passwd -d "$U" >/dev/null; fi
    if [ -s "$NAME" ]; then usermod -c "$(cat "$NAME")" "$U"; fi
    # Reglages systeme conserves sur la partition d'etat (capot...)
    lumina-system apply || true
    # Autres comptes, invite, ecran de connexion
    lumina-users apply || true
    ;;
  set-name)
    n=$(printf '%s' "${2:-}" | tr -d '\n:' | cut -c1-64)
    printf '%s\n' "$n" > "$NAME"; chmod 644 "$NAME"
    usermod -c "$n" "$U"
    ;;
  set-password)
    IFS= read -r old || true
    IFS= read -r new || true
    if [ "$HAS_PASSWORD" = 1 ] && [ -s "$HASH" ]; then
      # Verification par la meme fonction crypt() que le systeme. Les mots
      # de passe passent par l'environnement, jamais par la ligne de
      # commande (visible de tous dans ps).
      P="$old" H="$(cat "$HASH")" perl -e 'exit(crypt($ENV{P}, $ENV{H}) eq $ENV{H} ? 0 : 1)' \
        || { echo "Mot de passe actuel incorrect." >&2; exit 2; }
    fi
    if [ -z "$new" ]; then
      rm -f "$HASH"; passwd -d "$U" >/dev/null; HAS_PASSWORD=0
    else
      salt=$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9./' | head -c 16)
      h=$(P="$new" S="$salt" perl -e 'print crypt($ENV{P}, "\$6\$$ENV{S}\$")')
      ( umask 077; printf '%s\n' "$h" > "$HASH" )
      usermod -p "$h" "$U"; HAS_PASSWORD=1
    fi
    save
    ;;
  finish)
    CONFIGURED=1; save
    lumina-users apply || true
    ;;
  *)
    echo "usage : lumina-account apply|set-name NOM|set-password|finish" >&2; exit 1 ;;
esac
