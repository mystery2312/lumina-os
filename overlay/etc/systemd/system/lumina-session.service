[Unit]
Description=Session LuminaOS (labwc + lumina-shell)
After=systemd-user-sessions.service plymouth-quit-wait.service seatd.service
Wants=seatd.service var-lib-lumina.mount lumina-prepare-home.service lumina-account.service
# La partition d'etat peut etre lente a monter (fsck au demarrage) : on
# l'attend, puis on retablit ses droits avant que Chromium n'y ecrive.
After=var-lib-lumina.mount lumina-prepare-home.service lumina-account.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=lumina
# Les applis lancees depuis le bureau demarrent dans le dossier personnel
# (par defaut un service demarre dans /, et PCManFM ouvrirait la racine).
WorkingDirectory=~
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=lumina
# lumina-session choisit le rendu (GPU ou logiciel) puis lance labwc.
ExecStart=/usr/local/bin/lumina-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
