[Unit]
Description=Session LuminaOS (labwc + lumina-shell)
# Pas d'After=systemd-user-sessions : celui-ci attend le reseau (iwd,
# DHCP...), soit de longues secondes sur le chemin du bureau. Il ne sert
# qu'a lever /run/nologin, verifie par pam_nologin a l'authentification,
# etape que systemd ne fait pas pour un service.
After=seatd.service plymouth-start.service
# Comme un gestionnaire de connexion : la session prend l'ecran au logo
# (plymouth quit --retain-splash) des qu'elle demarre, au lieu d'attendre
# la fin de tout le demarrage.
Conflicts=plymouth-quit.service
After=plymouth-quit.service
OnFailure=plymouth-quit.service
Wants=seatd.service var-lib-lumina.mount lumina-prepare-home.service lumina-account.service
# La partition d'etat peut etre lente a monter (fsck au demarrage) : on
# l'attend, puis on retablit ses droits avant que Chromium n'y ecrive.
After=var-lib-lumina.mount lumina-prepare-home.service lumina-account.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=lumina
# Les applis lancees depuis le bureau demarrent dans le dossier personnel
# (par defaut un service demarre dans /, et PCManFM ouvrirait la racine).
WorkingDirectory=~
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=lumina
# lumina-session choisit le rendu (GPU ou logiciel) puis lance labwc.
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/local/bin/lumina-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
