[Unit]
Description=Demarrage de LuminaOS reussi
# Une nouvelle version n'est validee (systemd-bless-boot) qu'une fois l'ecran
# (bureau ou ecran de connexion) lance et toujours vivant 20 s plus tard. Sinon son compteur
# d'essais continue de baisser et l'ancienne version reprend la main.
Requires=greetd.service
After=greetd.service
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lumina-boot-ok

[Install]
# boot-complete.target n'existe qu'au demarrage UEFI avec essais comptes ;
# en BIOS, le service valide l'emplacement dans grubenv (lumina-boot-ok).
RequiredBy=boot-complete.target
WantedBy=graphical.target
