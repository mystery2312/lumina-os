[Unit]
Description=Demarrage de LuminaOS reussi
# Une nouvelle version n'est validee (systemd-bless-boot) qu'une fois le
# bureau lance et toujours vivant 20 s plus tard. Sinon son compteur
# d'essais continue de baisser et l'ancienne version reprend la main.
Requires=lumina-session.service
After=lumina-session.service
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'sleep 20; systemctl is-active --quiet lumina-session'

[Install]
RequiredBy=boot-complete.target
