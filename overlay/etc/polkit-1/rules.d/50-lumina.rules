// La session active peut lancer la recherche de mises a jour (Reglages),
// et ce service-la seulement : rien d'autre dans systemd.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "lumina-update.service" &&
      action.lookup("verb") == "start" &&
      subject.active && subject.local) {
    return polkit.Result.YES;
  }
});

// Date et heure : fuseau horaire et heure automatique (Reglages).
polkit.addRule(function(action, subject) {
  if ((action.id == "org.freedesktop.timedate1.set-timezone" ||
       action.id == "org.freedesktop.timedate1.set-ntp") &&
      subject.active && subject.local) {
    return polkit.Result.YES;
  }
});
