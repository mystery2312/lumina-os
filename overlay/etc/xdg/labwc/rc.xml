<?xml version="1.0"?>
<!-- Configuration labwc de LuminaOS. Les fenetres sont dessinees par les
     applications elles-memes (Chromium dessine ses onglets dans la barre de
     titre, comme sur la maquette) ; labwc ne fait que les placer. -->
<labwc_config>
  <core>
    <decoration>client</decoration>
    <gap>8</gap>
  </core>
  <placement>
    <policy>center</policy>
  </placement>
  <theme>
    <name>Lumina</name>
    <cornerRadius>16</cornerRadius>
    <dropShadows>yes</dropShadows>
    <!-- Pas d'icone de fenetre : labwc afficherait son logo par defaut pour
         toutes les applis web. Boutons a droite, comme sur Aluminium. -->
    <titlebar><layout>:iconify,max,close</layout></titlebar>
    <font place="ActiveWindow"><name>Roboto</name><size>11</size></font>
    <font place="InactiveWindow"><name>Roboto</name><size>11</size></font>
    <font place="OnScreenDisplay"><name>Roboto</name><size>10</size></font>
  </theme>
  <!-- Bureaux virtuels facon ChromeOS (Windows + 1..4, Windows + [ / ]) -->
  <desktops>
    <popupTime>700</popupTime>
    <names>
      <name>Bureau 1</name>
      <name>Bureau 2</name>
      <name>Bureau 3</name>
      <name>Bureau 4</name>
    </names>
  </desktops>
  <!-- Loupe (accessibilite) : Windows + Ctrl + M, puis Windows + Ctrl + +/- -->
  <magnifier>
    <width>720</width>
    <height>420</height>
    <initScale>2.0</initScale>
    <increment>0.5</increment>
    <useFilter>true</useFilter>
  </magnifier>
  <!-- Clic sur le bureau : pas de menu labwc (Reconfigurer/Quitter) -->
  <mouse>
    <default />
    <context name="Root">
      <mousebind button="Left" action="Press" />
      <mousebind button="Right" action="Press" />
      <mousebind button="Middle" action="Press" />
    </context>
  </mouse>
  <windowSwitcher show="yes" preview="no" outlines="no">
    <fields><field content="title" width="100%" /></fields>
  </windowSwitcher>
  <keyboard>
    <default />
    <!-- Touche Windows seule : tiroir d'applications, comme sur Android/ChromeOS -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="pkill -USR1 -x lumina-shell" />
    </keybind>
    <!-- Windows + A : reglages rapides -->
    <keybind key="W-a">
      <action name="Execute" command="pkill -USR2 -x lumina-shell" />
    </keybind>
    <!-- Windows + Espace : Lumi, l'assistant -->
    <keybind key="W-space"><action name="Execute" command="lumina-lumi" /></keybind>
    <!-- Windows + E : Lumi aide a ecrire dans n'importe quelle appli -->
    <keybind key="W-e"><action name="Execute" command="lumina-lumi --write" /></keybind>
    <!-- Windows + S : question sur une zone de l'ecran (Lumi lit le texte) -->
    <keybind key="W-s"><action name="Execute" command="lumina-lumi --screen" /></keybind>
    <!-- Impr : capture de l'ecran ; Maj + Impr : d'une zone -->
    <keybind key="Print"><action name="Execute" command="lumina-screenshot" /></keybind>
    <keybind key="S-Print"><action name="Execute" command="lumina-screenshot --zone" /></keybind>
    <!-- Windows + L : verrouiller -->
    <keybind key="W-l">
      <action name="Execute" command="lumina-lock" />
    </keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <!-- Raccourcis de ChromeOS : Alt + [ et ] ancrent a gauche / a droite
         (ecran partage), Alt + = agrandit, Alt + - reduit -->
    <keybind key="A-bracketleft"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="A-bracketright"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="A-equal"><action name="ToggleMaximize" /></keybind>
    <keybind key="A-minus"><action name="Iconify" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <!-- Bureaux : Windows + [ / ] change de bureau, + Maj y envoie la fenetre -->
    <keybind key="W-bracketleft"><action name="GoToDesktop" to="left" wrap="no" /><action name="Execute" command="lumina-shell --action at-desk-prev" /></keybind>
    <keybind key="W-bracketright"><action name="GoToDesktop" to="right" wrap="no" /><action name="Execute" command="lumina-shell --action at-desk-next" /></keybind>
    <keybind key="W-S-bracketleft"><action name="Execute" command="lumina-shell --action moved-prev-follow" /><action name="SendToDesktop" to="left" follow="yes" wrap="no" /></keybind>
    <keybind key="W-S-bracketright"><action name="Execute" command="lumina-shell --action moved-next-follow" /><action name="SendToDesktop" to="right" follow="yes" wrap="no" /></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /><action name="Execute" command="lumina-shell --action at-desk-1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /><action name="Execute" command="lumina-shell --action at-desk-2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /><action name="Execute" command="lumina-shell --action at-desk-3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /><action name="Execute" command="lumina-shell --action at-desk-4" /></keybind>
    <keybind key="W-S-1"><action name="Execute" command="lumina-shell --action moved-1" /><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-S-2"><action name="Execute" command="lumina-shell --action moved-2" /><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-S-3"><action name="Execute" command="lumina-shell --action moved-3" /><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-S-4"><action name="Execute" command="lumina-shell --action moved-4" /><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <!-- Claviers AZERTY (France, Belgique) : sans Maj, la rangee des chiffres
         donne & e " ' ; memes raccourcis sur ces touches -->
    <keybind key="W-ampersand"><action name="GoToDesktop" to="1" /><action name="Execute" command="lumina-shell --action at-desk-1" /></keybind>
    <keybind key="W-eacute"><action name="GoToDesktop" to="2" /><action name="Execute" command="lumina-shell --action at-desk-2" /></keybind>
    <keybind key="W-quotedbl"><action name="GoToDesktop" to="3" /><action name="Execute" command="lumina-shell --action at-desk-3" /></keybind>
    <keybind key="W-apostrophe"><action name="GoToDesktop" to="4" /><action name="Execute" command="lumina-shell --action at-desk-4" /></keybind>
    <keybind key="W-S-ampersand"><action name="Execute" command="lumina-shell --action moved-1" /><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-S-eacute"><action name="Execute" command="lumina-shell --action moved-2" /><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-S-quotedbl"><action name="Execute" command="lumina-shell --action moved-3" /><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-S-apostrophe"><action name="Execute" command="lumina-shell --action moved-4" /><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <!-- Vue d'ensemble des fenetres et des bureaux -->
    <keybind key="W-Tab"><action name="Execute" command="lumina-shell --action overview" /></keybind>
    <keybind key="F5" ><action name="Execute" command="lumina-shell --action overview" /></keybind>
    <!-- Historique du presse-papiers, emojis -->
    <keybind key="W-v"><action name="Execute" command="lumina-shell --action clipboard" /></keybind>
    <keybind key="W-period"><action name="Execute" command="lumina-shell --action emoji" /></keybind>
    <!-- Windows + Maj + S : barre de capture (ecran ou zone, photo ou video) -->
    <keybind key="W-S-s"><action name="Execute" command="lumina-shell --action capture" /></keybind>
    <!-- Ctrl + Impr : enregistrer l'ecran (demarrer / arreter) -->
    <keybind key="C-Print"><action name="Execute" command="lumina-record" /></keybind>
    <!-- Loupe -->
    <keybind key="W-C-m"><action name="ToggleMagnify" /></keybind>
    <keybind key="W-C-equal"><action name="ZoomIn" /></keybind>
    <keybind key="W-C-minus"><action name="ZoomOut" /></keybind>
    <!-- Touches multimedia des claviers (portables surtout) -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="lumina-osd vol-up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="lumina-osd vol-down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="lumina-osd mute" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="lumina-osd mic-mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="lumina-osd bright-up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="lumina-osd bright-down" /></keybind>
    <keybind key="XF86AudioPlay"><action name="Execute" command="sh -c 'busctl --user call org.mpris.MediaPlayer2.chromium.instance$(pgrep -o -f /usr/lib/chromium/chromium) /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player PlayPause'" /></keybind>
    <keybind key="XF86Calculator"><action name="Execute" command="lumina-calc" /></keybind>
    <keybind key="XF86Explorer"><action name="Execute" command="lumina-files" /></keybind>
    <keybind key="XF86Search"><action name="Execute" command="lumina-shell --action launcher" /></keybind>
    <!-- Windows + Echap : gestionnaire de taches -->
    <keybind key="W-Escape"><action name="Execute" command="lumina-tasks" /></keybind>
    <!-- Aide : liste des raccourcis -->
    <keybind key="C-A-slash"><action name="Execute" command="lumina-settings raccourcis" /></keybind>
  </keyboard>
</labwc_config>
