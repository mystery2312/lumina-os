# Lance par labwc a l'ouverture de session.
. /etc/lumina/session.conf 2>/dev/null

# Acceleration 3D reelle ou emulee ? Le resultat sert a lumina-browser
# (--disable-gpu) et, au prochain demarrage, au compositeur (pixman).
GPU=$(lumina-shell --probe-gl 2>/dev/null | cut -f1)
echo "${GPU:-software}" > "$XDG_RUNTIME_DIR/lumina-gpu"
if [ "${GPU:-software}" = software ] && [ "${LUMINA_RENDERER:-auto}" = auto ]; then
  echo pixman > /var/lib/lumina/renderer 2>/dev/null
fi

lumina-shell &

# Demarrage sur la cle USB (mode essai) : l'installateur s'ouvre, et reste
# disponible dans le tiroir. Une fois LuminaOS installe, il disparait.
APPS="$HOME/.local/share/applications"
if lumina-is-live; then
  mkdir -p "$APPS"
  cp /usr/local/share/lumina/lumina-install.desktop "$APPS/"
  lumina-install --welcome &
else
  rm -f "$APPS/lumina-install.desktop"
fi
lumina-fetch-icons &
[ "${LUMINA_OPEN_BROWSER:-yes}" = yes ] && lumina-browser &
