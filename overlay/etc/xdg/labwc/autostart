# Lance par labwc a l'ouverture de session.
. /etc/lumina/session.conf 2>/dev/null

# (le rendu, GPU ou logiciel, est choisi par lumina-session avant labwc)
lumina-shell &

# Demarrage sur la cle USB (mode essai) : l'installateur s'ouvre, et reste
# disponible dans le tiroir. Une fois LuminaOS installe, il disparait.
APPS="$HOME/.local/share/applications"
if lumina-is-live; then
  mkdir -p "$APPS"
  cp /usr/local/share/lumina/lumina-install.desktop "$APPS/"
  lumina-install --welcome &
else
  rm -f "$APPS/lumina-install.desktop"
fi
lumina-fetch-icons &
# (sur la cle, l'accueil de l'installateur passe avant le navigateur)
[ "${LUMINA_OPEN_BROWSER:-yes}" = yes ] && ! lumina-is-live && lumina-browser &
