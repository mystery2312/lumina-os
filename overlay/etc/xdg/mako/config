# Notifications LuminaOS (mako, demarre a la premiere notification).
font=Roboto 10
width=360
margin=12
padding=14,16
border-size=0
border-radius=16
default-timeout=6000
anchor=top-right
layer=overlay
max-visible=3
background-color=#e9efebf5
text-color=#171d1a
progress-color=over #a1f2d7

# Indicateur de volume / luminosite : court, au centre en haut, sans
# historique.
[app-name=LuminaOS urgency=low]
anchor=top-center
width=260
default-timeout=1200
history=0

[urgency=critical]
default-timeout=0
background-color=#ffdad6f5
text-color=#410002

[mode=dark]
background-color=#252b28f5
text-color=#dee4e0

# Ne pas deranger (reglages rapides) : rien ne s'affiche, tout va dans
# l'historique ; les alertes critiques passent quand meme.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
