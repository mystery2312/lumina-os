# --- Noyau et init ----------------------------------------------------
linux-image-amd64
systemd-sysv
udev
dbus-broker
systemd-timesyncd
systemd-resolved

# --- Graphique : wlroots, pas de X11 ----------------------------------
# labwc gere les fenetres (~10 Mo) ; lumina-shell (compile depuis src/)
# dessine le bureau : fond, barre d'etat, barre de taches, tiroir, reglages.
labwc
seatd
libgtk-layer-shell0
# eglinfo : lumina-session interroge le GPU avant de demarrer labwc
mesa-utils-bin
librsvg2-common
fonts-roboto
brightnessctl
# polkit autorise "Eteindre/Redemarrer" depuis la session active
polkitd
libgl1-mesa-dri
libglx-mesa0
fonts-dejavu-core

# --- Le navigateur = l'OS ---------------------------------------------
chromium
# traductions de l'interface (on ne garde que fr et en-US, cf. lumina-setup)
chromium-l10n

# --- Fichiers, terminal et Linux facon ChromeOS ----------------------
# Fichiers : lumina-files (src/). gvfs + udisks2 : corbeille, cles USB.
gvfs
gvfs-daemons
udisks2
adwaita-icon-theme
# foot : terminal Wayland le plus leger (< 10 Mo)
foot
# Linux dans un conteneur Debian, comme Crostini sur ChromeOS :
# Distrobox + Podman sans privileges. Rien ne tourne tant qu'on ne s'en
# sert pas ; les applis graphiques installees dedans arrivent dans le tiroir.
podman
distrobox
uidmap
passt
fuse-overlayfs
# Xwayland, demarre seulement a l'ouverture d'une appli X11 du conteneur
xwayland

# --- Installation sur disque (depuis la cle USB) --------------------
# lumina-install (src/) + lumina-install-disk ; pkexec pour ecrire le
# disque depuis la session, efibootmgr pour l'entree du firmware.
pkexec
rsync
gdisk
efibootmgr
systemd-boot-efi

# --- Secure Boot : chaine de confiance de Debian -----------------------
# shim (signe par Microsoft) -> systemd-boot et noyau (signes par Debian) :
# LuminaOS demarre sans desactiver le Secure Boot.
shim-signed
shim-helpers-amd64-signed
systemd-boot-efi-amd64-signed

# --- Ecran de demarrage (logo LuminaOS, cache les messages de Debian) ---
plymouth

# --- PC anciens sans UEFI (BIOS) : GRUB, meme logique A/B ---------------
grub-pc-bin
grub2-common

# --- Mises a jour A/B ---------------------------------------------------
# minisign : verifie la signature du manifeste avant toute ecriture.
minisign
# systemd-boot : systemd-bless-boot valide un demarrage reussi (sinon
# retour automatique a l'ancienne version) ; zstd : images compressees.
systemd-boot
zstd

# --- Verrouillage, capture d'ecran, notifications ---------------------
swaylock
swayidle
wlopm
grim
wlr-randr
slurp
mako-notifier
libnotify-bin

# --- Bluetooth : le demon ne demarre que si la machine a un adaptateur
# (ConditionPathIsDirectory=/sys/class/bluetooth) ; casques via PipeWire.
bluez
libspa-0.2-bluetooth

# --- Reseau : iwd + networkd (~8 Mo contre ~60 pour NetworkManager) ---
iwd
iproute2
iputils-ping
ca-certificates
# curl : telechargement des icones officielles des applis web
curl

# --- Memoire : le poste le plus important sur une machine a 2 Go ------
zram-tools

# --- Audio ------------------------------------------------------------
pipewire
pipewire-pulse
wireplumber

# --- Langue : fr_FR.UTF-8 genere (les applis GTK traduisent via gettext,
# qui ignore LANGUAGE quand la locale est C)
locales

# --- Outils de survie / debug -----------------------------------------
e2fsprogs
dosfstools
less
nano

# --- Fonctions facon ChromeOS -----------------------------------------
# Eclairage nocturne (filtre chaud le soir)
wlsunset
# Enregistrement de l'ecran
wf-recorder
# Presse-papiers : historique (Windows + V), copie et frappe d'emojis
wl-clipboard
cliphist
wtype
# Ecrans : affichage recopie (meme image sur deux ecrans)
wl-mirror
# Impression : imprimantes reseau et USB detectees sans pilote (IPP)
cups
cups-browsed
avahi-daemon
# Accessibilite : lecteur d'ecran (synthese vocale)
orca
# Imprimantes USB recentes (IPP sur USB, sans pilote)
ipp-usb
# Applis de base : Texte (GtkSourceView), Galerie et Camera (GStreamer)
libgtksourceview-4-0
gstreamer1.0-plugins-base
gstreamer1.0-plugins-good
gstreamer1.0-gtk3
gstreamer1.0-libav
# Ouverture des fichiers et dossiers depuis Chromium (xdg-open)
xdg-utils
# Archives (zip, tar, 7z) dans Fichiers : extraire, compresser
libarchive-tools
